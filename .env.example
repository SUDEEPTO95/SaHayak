SAHAYAK_OWNER_EMAIL=owner@sahayak.local
SAHAYAK_AI_ENABLED=false
SAHAYAK_WHATSAPP_ENABLED=false
SAHAYAK_API_BASE=http://127.0.0.1:8080
SAHAYAK_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Required only when using infra/docker-compose.yml. Use unique local secrets.
POSTGRES_PASSWORD=replace-with-a-local-secret
MINIO_ROOT_USER=replace-with-a-local-user
MINIO_ROOT_PASSWORD=replace-with-a-local-secret
